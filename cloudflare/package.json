{
  "name": "auditai-cloudflare-worker",
  "version": "2.0.0",
  "description": "Cloudflare Worker edge gateway for AuditAI (D1 SQLite & R2 Audio Storage)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create auditai-d1-prod",
    "d1:migrate:local": "wrangler d1 execute auditai-d1-prod --local --file=../database/cloudflare_d1_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute auditai-d1-prod --remote --file=../database/cloudflare_d1_schema.sql",
    "r2:create": "wrangler r2 bucket create auditai-recordings-storage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.10"
  }
}
