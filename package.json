{
  "name": "auditai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend engine for AuditAI quality monitoring platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t auditai-backend:latest -f docker/Dockerfile .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "tsx scripts/migrate.ts",
    "user:provision": "tsx scripts/provision-demo-user.ts",
    "prepare": "husky || true"
  },
  "keywords": [
    "auditai",
    "backend",
    "express",
    "typescript",
    "quality-monitoring",
    "supabase",
    "bullmq",
    "pino",
    "zod"
  ],
  "author": "AuditAI Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@supabase/supabase-js": "^2.48.1",
    "assemblyai": "^4.36.4",
    "bullmq": "^5.34.8",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
