    # Core Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Security & CORS
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=false
BODY_SIZE_LIMIT=10mb
# Must be true in production. A Supabase-authenticated membership is then
# required for every tenant API call.
REQUIRE_TENANT_AUTH=false

# Supabase Platform Infrastructure
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=sample_anon_key
SUPABASE_SERVICE_ROLE_KEY=sample_service_role_key
# Direct Postgres link for running migrations (e.g. postgresql://postgres:[password]@db.xyz.supabase.co:5432/postgres)
DATABASE_URL=

# Third-Party Integrations & Services
ASSEMBLYAI_API_KEY=sample_assemblyai_key
# Optional comma-separated fallback credentials for high availability
ASSEMBLYAI_FALLBACK_API_KEYS=
GEMINI_API_KEY=sample_gemini_api_key
# Optional comma-separated fallback credentials for quota/service availability
GEMINI_FALLBACK_API_KEYS=
KNOWLARITY_WEBHOOK_SECRET=sample_knowlarity_secret
# 32 random bytes base64, e.g. generated with `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=
# Comma-separated known Knowlarity recording hosts; never use a wildcard.
KNOWLARITY_RECORDING_HOSTS=
# Development-only Postman / test mechanism. Leave empty outside development.
DEV_WEBHOOK_TEST_SECRET=
# Redis Queue & Cache Configuration
# For Render / Upstash / Cloud: Set REDIS_URL (prefer REDIS_URL when set; supports redis:// and rediss:// with TLS)
REDIS_URL=redis://localhost:6379
# For Local Development (used when REDIS_URL is omitted):
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Process Architecture (Render Deployment)
# When deploying separate Web API and Background Worker services on Render:
# - Web API service: set RUN_INLINE_WORKERS=false and run `npm start`
# - Background Worker service: run `npm run start:worker`
# For local development or single-service deployment: leave true or unset.
RUN_INLINE_WORKERS=true

# PayU Payment Gateway Configuration (India Enterprise Billing)
PAYU_MERCHANT_KEY=sample_payu_merchant_key
PAYU_SALT=sample_payu_salt
PAYU_MODE=test # test or production
PAYU_SUCCESS_URL=http://localhost:5173/?payment=success
PAYU_FAILURE_URL=http://localhost:5173/?payment=failure

# Cloudflare D1 SQL Relational Database & R2 Zero-Egress Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_WORKER_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=auditai-recordings-storage
CLOUDFLARE_R2_PUBLIC_URL=
JWT_SECRET=auditai_enterprise_jwt_super_secret_key_2026

RAZORPAY_KEY_ID=sample_razorpay_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_key_secret

# ─────────────────────────────────────────────────────────────────────
# SECURITY: secrets above (GEMINI_API_KEY, ASSEMBLYAI_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY, KNOWLARITY_WEBHOOK_SECRET) must ONLY ever
# appear in this backend .env. They must NEVER be prefixed with VITE_
# or exposed to the frontend — the browser talks exclusively to /api,
# and all AI provider calls happen server-side.
# ─────────────────────────────────────────────────────────────────────
